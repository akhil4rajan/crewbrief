# Review portal configuration (Vite reads VITE_* at dev/build time; the container
# entrypoint reads the same names at start-up and writes /config.js).
VITE_API_BASE_URL=http://localhost:8001
VITE_GATEWAY_URL=http://localhost:8000
VITE_AUTH_MODE=dev
# Entra ID (only when VITE_AUTH_MODE=entra)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_SCOPES=api://<api-client-id>/access_as_user
# Briefing simulator: auto (local API mode or dev build) | on | off
VITE_SIMULATOR=auto
