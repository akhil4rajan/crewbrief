{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/VoicePrompt.json",
  "additionalProperties": false,
  "properties": {
    "gap_id": {
      "title": "Gap Id",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "priority": {
      "default": 0,
      "title": "Priority",
      "type": "integer"
    },
    "audio_b64": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio B64"
    },
    "audio_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Format"
    }
  },
  "required": [
    "gap_id",
    "text"
  ],
  "title": "VoicePrompt",
  "type": "object"
}
