{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/Session.json",
  "$defs": {
    "Clarification": {
      "additionalProperties": false,
      "description": "A critical question asked aloud once the crew ends the briefing (standup mode).",
      "properties": {
        "gap_id": {
          "title": "Gap Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClarificationStatus",
          "default": "open"
        },
        "asked_at": {
          "format": "date-time",
          "title": "Asked At",
          "type": "string"
        },
        "answered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered At"
        }
      },
      "required": [
        "gap_id",
        "question"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "ClarificationStatus": {
      "enum": [
        "open",
        "answered",
        "skipped"
      ],
      "title": "ClarificationStatus",
      "type": "string"
    },
    "RecordingState": {
      "enum": [
        "idle",
        "active",
        "paused"
      ],
      "title": "RecordingState",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "CREATED",
        "BRIEFING",
        "DRAFTING",
        "GAP_CHECK",
        "REVIEW",
        "SIGNED",
        "SUBMITTED",
        "ABANDONED"
      ],
      "title": "SessionState",
      "type": "string"
    },
    "SpeakerAssignment": {
      "additionalProperties": false,
      "description": "Who a diarized voice is, as set at review (applied to that voice's later segments too).",
      "properties": {
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SpeakerAssignment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SessionState",
      "default": "CREATED"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "supervisor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supervisor Id"
    },
    "crew_member_ids": {
      "items": {
        "type": "string"
      },
      "title": "Crew Member Ids",
      "type": "array"
    },
    "work_order_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Order Id"
    },
    "task_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Type"
    },
    "location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "recording": {
      "$ref": "#/$defs/RecordingState",
      "default": "idle"
    },
    "consent_acknowledged_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consent Acknowledged At"
    },
    "signed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed By"
    },
    "signed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed At"
    },
    "sign_off_comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sign Off Comment"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "submission_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Ref"
    },
    "abandon_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abandon Reason"
    },
    "ai_draft_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ai Draft Revision"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/Clarification"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "speaker_assignments": {
      "additionalProperties": {
        "$ref": "#/$defs/SpeakerAssignment"
      },
      "title": "Speaker Assignments",
      "type": "object"
    }
  },
  "required": [
    "title",
    "created_by"
  ],
  "title": "Session",
  "type": "object"
}
