{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/VerifierResponse.json",
  "$defs": {
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GapKind"
        },
        "severity": {
          "$ref": "#/$defs/GapSeverity"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "status": {
          "$ref": "#/$defs/GapStatus",
          "default": "open"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "asked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asked At"
        }
      },
      "required": [
        "id",
        "kind",
        "severity",
        "path",
        "message"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GapKind": {
      "enum": [
        "unsupported_field",
        "high_risk_without_control",
        "hazard_without_control",
        "contradiction",
        "missing_required_field",
        "unconfirmed_hazard",
        "low_confidence"
      ],
      "title": "GapKind",
      "type": "string"
    },
    "GapSeverity": {
      "enum": [
        "blocking",
        "warning",
        "info"
      ],
      "title": "GapSeverity",
      "type": "string"
    },
    "GapStatus": {
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ],
      "title": "GapStatus",
      "type": "string"
    },
    "RoleMeta": {
      "additionalProperties": false,
      "description": "Attached to every role response, recorded in the audit log.",
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        }
      },
      "required": [
        "role",
        "provider",
        "model",
        "prompt_version"
      ],
      "title": "RoleMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RoleMeta"
    }
  },
  "required": [
    "gaps",
    "meta"
  ],
  "title": "VerifierResponse",
  "type": "object"
}
