{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/TranscriptSegment.json",
  "$defs": {
    "SegmentSource": {
      "enum": [
        "azure_stt",
        "device_text",
        "replay",
        "voice_prompt"
      ],
      "title": "SegmentSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "speaker_id": {
      "title": "Speaker Id",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    },
    "speaker_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speaker Name"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "start_ms": {
      "default": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "end_ms": {
      "default": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "is_final": {
      "default": true,
      "title": "Is Final",
      "type": "boolean"
    },
    "language": {
      "default": "en-AU",
      "title": "Language",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SegmentSource",
      "default": "azure_stt"
    },
    "filtered": {
      "default": false,
      "title": "Filtered",
      "type": "boolean"
    },
    "filter_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filter Reason"
    },
    "redacted": {
      "default": false,
      "title": "Redacted",
      "type": "boolean"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "speaker_id",
    "text"
  ],
  "title": "TranscriptSegment",
  "type": "object"
}
