{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/Observation.json",
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A pointer to the transcript span that supports a field.",
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Id"
        },
        "start_ms": {
          "default": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "default": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "quote": {
          "default": "",
          "maxLength": 1000,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "segment_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ObservationKind": {
      "enum": [
        "job_detail",
        "task",
        "site_condition",
        "hazard",
        "control",
        "ppe",
        "emergency",
        "permit",
        "answer"
      ],
      "title": "ObservationKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ObservationKind"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "code_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Hint"
    },
    "negated": {
      "default": false,
      "title": "Negated",
      "type": "boolean"
    },
    "speaker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speaker Id"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "text"
  ],
  "title": "Observation",
  "type": "object"
}
