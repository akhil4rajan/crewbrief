{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/VoicePrompterResponse.json",
  "$defs": {
    "RoleMeta": {
      "additionalProperties": false,
      "description": "Attached to every role response, recorded in the audit log.",
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        }
      },
      "required": [
        "role",
        "provider",
        "model",
        "prompt_version"
      ],
      "title": "RoleMeta",
      "type": "object"
    },
    "VoicePrompt": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "title": "Gap Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "audio_b64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio B64"
        },
        "audio_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Format"
        }
      },
      "required": [
        "gap_id",
        "text"
      ],
      "title": "VoicePrompt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "prompts": {
      "items": {
        "$ref": "#/$defs/VoicePrompt"
      },
      "title": "Prompts",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RoleMeta"
    }
  },
  "required": [
    "prompts",
    "meta"
  ],
  "title": "VoicePrompterResponse",
  "type": "object"
}
