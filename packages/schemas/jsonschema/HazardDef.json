{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/HazardDef.json",
  "$defs": {
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "typical_controls": {
      "items": {
        "type": "string"
      },
      "title": "Typical Controls",
      "type": "array"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "code",
    "name",
    "category",
    "severity"
  ],
  "title": "HazardDef",
  "type": "object"
}
