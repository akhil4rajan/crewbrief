{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewbrief.dev/schemas/SignOffRequest.json",
  "additionalProperties": false,
  "properties": {
    "comment": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "override_blocking_gaps": {
      "default": false,
      "title": "Override Blocking Gaps",
      "type": "boolean"
    },
    "override_justification": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Justification"
    }
  },
  "title": "SignOffRequest",
  "type": "object"
}
