# Build context for the root (backend) Dockerfile. Allow-list style: ignore
# everything, then re-include only what the image needs.
*
!pyproject.toml
!packages/
!services/
!knowledge/
!scripts/container_healthcheck.py

# Never ship secrets, caches or local data, even inside re-included folders.
**/.env
**/.env.*
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/var
