# =============================================================================
# CrewBrief configuration — LOCAL DUMMY VALUES (safe to commit)
# -----------------------------------------------------------------------------
# .env          committed, DUMMY values only, so the stack runs locally offline.
# .env.local    NOT committed. Put real keys here; it overrides .env.
# Azure (dev/test/prod): no keys at all. Services use managed identity
# (DefaultAzureCredential) and config is injected by Container Apps / Key Vault.
# Any value containing "dummy" is treated as unset by the code.
# =============================================================================

# --- General -----------------------------------------------------------------
CREWBRIEF_ENV=local
# local = offline stand-ins for every Azure dependency; azure = real services
CREWBRIEF_MODE=local
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
DATA_DIR=./var

# Per-integration overrides (local | azure). Leave empty to follow CREWBRIEF_MODE.
# Example: run everything locally but use a real Azure OpenAI deployment -> LLM_PROVIDER=azure
STT_PROVIDER=
LLM_PROVIDER=
SEARCH_PROVIDER=
STORE_PROVIDER=
PUBSUB_PROVIDER=
VOICE_PROVIDER=
PII_PROVIDER=

# --- Internal service URLs ---------------------------------------------------
GATEWAY_URL=http://localhost:8000
FORM_API_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8002
ROLES_URL=http://localhost:8003
ROLES_IN_PROCESS=false
PUBLIC_GATEWAY_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Auth --------------------------------------------------------------------
# dev = local HS256 tokens for seeded users; entra = Entra ID (production)
AUTH_MODE=dev
DEV_JWT_SECRET=dummy-dev-jwt-secret-change-me-0000000000
DEV_TOKEN_TTL_MINUTES=720
INTERNAL_SERVICE_TOKEN=dummy-internal-service-token
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Azure AI Speech ---------------------------------------------------------
AZURE_SPEECH_ENDPOINT=https://dummy-crewbrief-speech.cognitiveservices.azure.com/
AZURE_SPEECH_REGION=australiaeast
AZURE_SPEECH_KEY=dummy-azure-speech-key-00000000000000000000
SPEECH_LANGUAGE=en-AU
CUSTOM_SPEECH_ENDPOINT_ID=
STT_MIN_CONFIDENCE=0.55

# --- Azure OpenAI (Foundry) --------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://dummy-crewbrief-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=dummy-azure-openai-key-00000000000000000000
AZURE_OPENAI_API_VERSION=2024-10-21
EXTRACTOR_DEPLOYMENT=gpt-4o-mini
VERIFIER_DEPLOYMENT=gpt-4o
LLM_TIMEOUT_SECONDS=20
LLM_FALLBACK_TO_HEURISTIC=true

# --- Voice Live API ----------------------------------------------------------
VOICE_LIVE_ENDPOINT=wss://dummy-crewbrief-voicelive.cognitiveservices.azure.com/voice-live/realtime
VOICE_LIVE_API_KEY=dummy-voice-live-key-00000000000000000000
VOICE_NAME=en-AU-NatashaNeural

# --- Azure AI Search ---------------------------------------------------------
SEARCH_ENDPOINT=https://dummy-crewbrief-search.search.windows.net
SEARCH_INDEX=hazards
SEARCH_API_KEY=dummy-azure-search-key-00000000000000000000

# --- Cosmos DB ---------------------------------------------------------------
COSMOS_ENDPOINT=https://dummy-crewbrief-cosmos.documents.azure.com:443/
COSMOS_KEY=dummy-cosmos-key-00000000000000000000
COSMOS_DATABASE=crewbrief
# Local store (used when STORE_PROVIDER/CREWBRIEF_MODE is local)
SQLITE_PATH=./var/crewbrief.db

# --- Azure Web PubSub --------------------------------------------------------
WEBPUBSUB_ENDPOINT=https://dummy-crewbrief-pubsub.webpubsub.azure.com
WEBPUBSUB_HUB=crewbrief
WEBPUBSUB_KEY=dummy-webpubsub-key-00000000000000000000

# --- Azure AI Language (PII redaction) ---------------------------------------
AZURE_LANGUAGE_ENDPOINT=https://dummy-crewbrief-language.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=dummy-azure-language-key-00000000000000000000

# --- Downstream safety system (submission target) -----------------------------
# Empty = write submissions to ./var/submissions (local)
DOWNSTREAM_SUBMISSION_URL=

# --- Observability -----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=dummy-00000000-0000-0000-0000-000000000000

# --- Behaviour ---------------------------------------------------------------
EXTRACTION_INTERVAL_SECONDS=8
VERIFIER_EVERY_N_EXTRACTIONS=3
VOICE_PROMPT_COOLDOWN_SECONDS=20
RETAIN_RAW_AUDIO=false
PII_REDACTION=true
PROMPT_VERSION=v1

# --- Frontends (Vite reads these at build time) ------------------------
VITE_API_BASE_URL=http://localhost:8001
VITE_GATEWAY_URL=http://localhost:8000
